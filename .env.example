# Copy to .env.local and fill in. Never commit the filled-in copy.

# ---------------------------------------------------------------- storage
# Blob backend for audio: `local` (filesystem under data/, used by dev and
# tests) or `vercel` (Vercel Blob, used by the batch publisher and the
# deployed app).
BLOB_BACKEND=local

# Vercel Blob read-write token. Only needed when BLOB_BACKEND=vercel and the
# project is not linked (a linked project authenticates via OIDC instead).
# Get it from: vercel env pull, or the Storage tab in the dashboard.
BLOB_READ_WRITE_TOKEN=

# Public base URL of the blob store, e.g.
#   https://<store-id>.public.blob.vercel-storage.com
# The API resolves object keys against this to build 302 redirect targets.
# Switching to Cloudflare R2 later means changing only this value plus
# BLOB_BACKEND (docs/infrastructure-plan.md §4.2).
BLOB_BASE_URL=

# ---------------------------------------------------------------- database
# Postgres connection string (Supabase). Unset locally, where the app falls
# back to SQLite under data/.
#
# IMPORTANT: use the *transaction pooler* endpoint (port 6543), not the direct
# connection (5432). Serverless creates many short-lived connections and will
# exhaust direct connection limits under modest concurrency.
#   postgresql://postgres.<ref>:<pw>@aws-0-<region>.pooler.supabase.com:6543/postgres
DATABASE_URL=

# ---------------------------------------------------------------- ingestion
# Jamendo API client id (free). Required only for `mode: jamendo` ingestion.
# https://devportal.jamendo.com/
JAMENDO_CLIENT_ID=

# Override where local data lives (default: ./data)
# DJMIXER_DATA=
# Override the catalog config (default: ./config/tracks.json)
# DJMIXER_TRACKS=
