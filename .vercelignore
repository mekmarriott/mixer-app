# Keep the serverless bundle small — it competes with numpy for a 250 MB
# uncompressed limit (docs/infrastructure-plan.md §1.3).

tests/
docs/
data/
blobs/
*.md
!README.md

run_tests.sh
.venv/
node_modules/
__pycache__/

# Ingest-only dependencies must not be installed for the serving function.
requirements-ingest.txt

# Local-only working directories. None of these is in the repository, so a
# git-triggered deployment never sees them — but `vercel build`/`vercel deploy`
# bundle the working directory as-is, where the agent worktrees alone are 1.6 GB
# against a 500 MB function limit. Listing them keeps a local build honest.
.claude/
.vercel/
data-e2e/
.git/
