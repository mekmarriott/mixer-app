# Secrets.
#
# Only .env.example is public. Everything else matching `.env.*` stays local,
# including .env.local: tooling writes credentials into it unprompted — a
# `vercel link` appends a VERCEL_OIDC_TOKEN — so a committed .env.local is a
# standing invitation to publish one by accident. .env.example documents every
# variable, which is what a newcomer actually needs.
.env
.env.*
!.env.example

# Python
.venv/
venv/
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/

# Node / Playwright tooling (test-only; the app itself has no build step)
node_modules/
test-results/
playwright-report/
blob-report/

# Local PostgreSQL cluster created by `make up`
.pgdata/

# Vercel
.vercel/

# Sibling session worktrees live here — never part of the tree
.claude/worktrees/

# Generated at runtime — safe to delete, rebuilt by ingestion.
# Large and fully reproducible from config/tracks.json.
data/
data-e2e/
blobs/

# OS
.DS_Store

# Local screenshots from manual verification
*.png

# Synthetic server store — throwaway, rebuilt on demand
data-fixture/

# Vercel CLI link metadata (project/org ids, regenerated by `vercel link`).
.vercel/
