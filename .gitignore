# Secrets.
#
# .env.local is COMMITTED and must stay that way: it holds the shared local
# endpoints (see its header), and nothing secret goes in it. The `.env.*`
# pattern matches it, so the negation below is load-bearing — remove it and
# the file silently vanishes from git while still working on the machine that
# wrote it, which is the worst failure mode available to shared config.
.env
.env.*
!.env.example
!.env.local

# Python
.venv/
venv/
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/

# Node / Playwright tooling (test-only; the app itself has no build step)
node_modules/
test-results/
playwright-report/
blob-report/

# Local PostgreSQL cluster created by `make up`
.pgdata/

# Vercel
.vercel/

# Sibling session worktrees live here — never part of the tree
.claude/worktrees/

# Generated at runtime — safe to delete, rebuilt by ingestion.
# Large and fully reproducible from config/tracks.json.
data/
data-e2e/
blobs/

# OS
.DS_Store

# Local screenshots from manual verification
*.png

# Synthetic server store — throwaway, rebuilt on demand
data-fixture/

# Vercel CLI link metadata (project/org ids, regenerated by `vercel link`).
.vercel/
